# Python 缓存与构建产物
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
venv/
.venv/

# 工具缓存（mypy/ruff 会在自己目录里生成 .gitignore，这里再挡一层）
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 编辑器与系统
.DS_Store
*.bak
*.orig

# 采集产物：本地产出的数据，不入库
outputs/

# Claude Code：本地配置不入库，但项目自己的 skill 必须入库（要同步到远程）
.claude/*
!.claude/skills/
