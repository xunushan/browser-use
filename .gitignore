# Python 缓存与构建产物
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
venv/
.venv/

# 工具缓存（mypy/ruff 会在自己目录里生成 .gitignore，这里再挡一层）
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 编辑器与系统
.DS_Store
*.bak
*.orig

# 采集产物：本地产出的数据，不入库
outputs/

# Claude Code 本地配置。skill 本体开发在 skill/ 下，这里只放一个指向它的软链接
.claude/

# 扩展私钥：只在本机 ~/.chrome-agent/extension-key.pem 与备份里存在
*.pem
